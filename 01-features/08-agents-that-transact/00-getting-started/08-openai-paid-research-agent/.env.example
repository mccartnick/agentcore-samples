# Tutorial-specific overrides. Payment resource IDs are read from ../.env,
# which Tutorial 00 creates.
AWS_REGION=us-east-1
BEDROCK_OPENAI_MODEL=openai.gpt-5.5
OPENAI_REASONING_EFFORT=medium

# One application-approved x402 endpoint and a per-run testnet budget.
PAID_RESEARCH_URL=https://sandbox.node4all.com/v1/x402-test
PAID_RESEARCH_BUDGET=0.25
PAYMENT_SESSION_EXPIRY_MINUTES=60
